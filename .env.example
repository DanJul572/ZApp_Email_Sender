# Mode
# Set NODE_ENV in the shell or npm script (e.g. `pnpm dev`); it picks which .env.<NODE_ENV>*
# files are loaded, so a value here only fills in when the shell leaves it unset.
NODE_ENV=

# Secret Key
# Same value as ENCRYPTION_KEY of the API: it signs tracked links, the API checks them.
ENCRYPTION_KEY=

# RabbitMQ
# AMQP port, e.g. amqp://localhost:5673 (not the management UI port). RABBITMQ_USER and
# RABBITMQ_PASS are added to the URL when it has no credentials of its own.
RABBITMQ_URL=
RABBITMQ_USER=
RABBITMQ_PASS=
# Queue names default to <NODE_ENV>_<name>_queue; the API must use the same request queue name.
# API → this app (default <NODE_ENV>_email_request_queue)
EMAIL_REQUEST_QUEUE_NAME=
# Built emails, published and consumed by this app (default <NODE_ENV>_send_email_queue)
EMAIL_QUEUE_NAME=

# Database
# The same database as the API.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=
DB_DIALECT=

# Email
# SMTP server. A local test server such as Mailpit (SMTP 1025, web UI 8025) needs no login.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
# true for port 465 (SSL)
EMAIL_SECURE=
# Sender, e.g. "ZApp" <no-reply@yourdomain.com>
EMAIL_FROM=
# Emails sent at the same time (default 5)
EMAIL_CONCURRENCY=
# Send requests built at the same time (default 2).
EMAIL_REQUEST_CONCURRENCY=
# How often requests and emails whose queue message was lost are picked up (default 60).
EMAIL_SWEEP_INTERVAL_SECONDS=
# A request still being built after this many minutes is built again (default 30).
EMAIL_REQUEST_TIMEOUT_MINUTES=
# Set to true to send scheduled emails automatically.
EMAIL_SCHEDULER_ENABLED=
# How often due schedules are checked (default 60).
EMAIL_SCHEDULER_INTERVAL_SECONDS=
# Public address of the API's /api routes as recipients' mail clients reach it, e.g.
# https://zapp.example.com/api. Needed by open tracking, click tracking and unsubscribe links.
EMAIL_PUBLIC_URL=
