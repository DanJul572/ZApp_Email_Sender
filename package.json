{
  "name": "zapp-email-sender",
  "version": "1.0.0",
  "private": true,
  "description": "Sends the emails the ZApp worker app has prepared.",
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "cross-env NODE_ENV=development node app.js",
    "format": "prettier --write .",
    "check": "eslint . --max-warnings=0",
    "start": "node dist/app.js",
    "test": "jest"
  },
  "dependencies": {
    "amqplib": "^1.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "nodemailer": "^7.0.6",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "prettier": "^3.8.3"
  },
  "packageManager": "pnpm@10.33.2"
}
